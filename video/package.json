{
  "name": "hazel-injection-explainer",
  "version": "0.1.0",
  "private": true,
  "description": "灰泽满注入链路 Remotion explainer（样片 + EP01）",
  "scripts": {
    "studio": "remotion studio src/index.ts",

    "render": "remotion render src/index.ts HazelInjectionExplainer out/hazel-injection-explainer.mp4 --codec h264",
    "render:preview": "remotion render src/index.ts HazelInjectionExplainer out/hazel-injection-explainer-preview.mp4 --codec h264 --scale 0.5",
    "render:voice": "remotion render src/index.ts HazelInjectionExplainer out/hazel-injection-explainer-with-voice.mp4 --codec h264 --props=render-props-voice.json",
    "still": "remotion still src/index.ts HazelInjectionExplainer out/poster.png --frame=120",

    "ep01:studio": "remotion studio src/index.ts --props=render-props-ep01.json",
    "ep01:preview": "remotion render src/index.ts HazelBotEp01PersonaInjection out/ep01-preview.mp4 --codec h264 --scale 0.5",
    "ep01:render": "remotion render src/index.ts HazelBotEp01PersonaInjection out/hazel-bot-ep01-persona-injection.mp4 --codec h264",
    "ep01:render:voice": "remotion render src/index.ts HazelBotEp01PersonaInjection out/hazel-bot-ep01-persona-injection-with-voice.mp4 --codec h264 --props=render-props-ep01-voice.json",
    "ep01:still": "remotion still src/index.ts HazelBotEp01PersonaInjection out/ep01-poster.png --frame=60",
    "ep01:check": "node scripts/check-narration.mjs ep01",
    "ep01:check-anchors": "node scripts/check-anchors.mjs ep01",
    "ep01:check-acceptance": "node scripts/check-ep01-acceptance.mjs",
    "ep01:parts": "node scripts/split-ep01.mjs",
    "ep01:refit": "node scripts/redistribute-narration.mjs ep01 --write",
    "ep01:captions": "node scripts/export-captions.mjs ep01",
    "ep01:voiceover": "python scripts/generate-voiceover.py ep01 --port 9880 --speed 1.2",
    "ep01:verify-voice": "python scripts/verify-voiceover.py ep01 --speed 1.2",
    "ep01:voice-track": "python scripts/build-voiceover-track.py ep01",
    "ep01:fit-voice": "node scripts/fit-narration-to-audio.mjs ep01",
    "ep01:scene-timing": "node scripts/check-scene-timing.mjs ep01",
    "ep01:rebuild-voice": "npm run ep01:captions && npm run ep01:voiceover && npm run ep01:voice-track && npm run ep01:fit-voice -- --write && npm run ep01:captions",

    "captions": "node scripts/export-captions.mjs",
    "fit-voice": "node scripts/fit-narration-to-audio.mjs",
    "voiceover": "powershell -ExecutionPolicy Bypass -File scripts/generate-voiceover.ps1",
    "voice-api": "powershell -ExecutionPolicy Bypass -File scripts/start-speak-api.ps1"
  },
  "dependencies": {
    "@remotion/media": "4.0.531",
    "@remotion/cli": "4.0.531",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.531"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "typescript": "5.6.3"
  }
}
